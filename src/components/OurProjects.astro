---
import { siteConfig } from "@/config/site.config";

type ShowcaseItem = {
  title: string;
  description: string;
  image: string;
  link: string;
};

const projects = siteConfig.projects;
const showcaseItems: ShowcaseItem[] = siteConfig.portfolioPage.projects.slice(0, 6).map((p) => ({
  title: p.title,
  description: p.description,
  image: p.image,
  link: p.link,
}));
---

<section id="projects" class="border-t border-white/10 bg-[#0d0d0d] py-20 md:py-28">
  <div class="site-container">
    <div data-reveal="" class="max-w-3xl">
      <p class="text-sm font-medium tracking-[0.2em] text-[#f43f5e]">
        {projects.sectionLabel}
      </p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        {projects.title}
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
        {projects.subtitle}
      </p>
    </div>

    <div
      data-reveal-stagger=""
      class="mt-14 grid grid-cols-1 border-t border-white/15 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        showcaseItems.map((item) => (
          <a
            href={item.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col border-b border-white/15 px-0 py-8 transition-colors duration-300 hover:bg-[#f43f5e]/10 sm:px-6 sm:py-10 lg:px-8"
          >
            <div class="aspect-[16/10] w-full overflow-hidden bg-slate-900">
              {item.image ? (
                <img
                  src={item.image}
                  alt=""
                  class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-sm text-slate-500">
                  {item.title}
                </div>
              )}
            </div>
            <h3 class="mt-5 text-lg font-bold tracking-tight text-white transition-colors duration-300 md:text-xl group-hover:text-[#f43f5e]">
              {item.title}
            </h3>
            {item.description && (
              <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-slate-400 transition-colors duration-300 group-hover:text-[#fda4af]">
                {item.description}
              </p>
            )}
            <span class="mt-4 inline-flex items-center text-sm font-medium text-[#f43f5e]">
              {projects.viewMoreLabel}
              <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }

      <a
        href="/portfolio"
        class="group flex min-h-[10rem] items-end border-b border-white/15 bg-[#f43f5e] px-6 py-8 text-left transition hover:bg-[#e11d48] sm:col-span-2 sm:px-6 sm:py-10 lg:col-span-1 lg:px-8"
      >
        <span class="text-xl font-bold tracking-tight text-white md:text-2xl">
          {projects.viewMoreLabel}
          <span class="ml-2 inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>
