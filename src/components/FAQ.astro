---
import { siteConfig } from "@/config/site.config";

const section = siteConfig.faq;
---

<section id="faq" class="border-t border-white/10 bg-[#0d0d0d] py-20 md:py-28">
  <div class="site-container">
    <div data-reveal="" class="max-w-3xl">
      <p class="text-sm font-medium tracking-[0.2em] text-[#f43f5e]">
        {section.sectionLabel}
      </p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        {section.title}
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
        {section.subtitle}
      </p>
    </div>

    <div data-reveal-stagger="" class="mt-14 border-t border-white/15">
      {
        section.items.map((item) => (
          <details class="group border-b border-white/15">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left transition-colors duration-300 hover:text-[#f43f5e] md:py-7 [&::-webkit-details-marker]:hidden">
              <span class="text-base font-semibold tracking-tight text-white transition-colors duration-300 group-hover:text-[#f43f5e] md:text-lg">
                {item.q}
              </span>
              <span
                class="shrink-0 text-xl font-light leading-none text-[#f43f5e] transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="pb-7 pr-10 text-sm leading-relaxed text-slate-400 md:text-[0.95rem]">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
