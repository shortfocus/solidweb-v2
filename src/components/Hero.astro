---
import { siteConfig } from "@/config/site.config";
import HeroCanvas from "@/components/HeroCanvasWavesBlue";

const hero = siteConfig.hero;
---

<!-- 플로팅 헤더는 fixed라 히어로는 풀 뷰포트 -->
<section class="relative h-[100svh] max-h-[100svh] overflow-hidden bg-[#0d0d0d]">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <HeroCanvas client:load />
  </div>

  <div class="hero-dot-grid pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>

  <div
    class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-r from-[#0d0d0d]/95 via-[#0d0d0d]/55 to-transparent md:via-[#0d0d0d]/35"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-[#0d0d0d] via-[#0d0d0d]/35 to-[#0d0d0d]/25"
    aria-hidden="true"
  ></div>

  <div class="pointer-events-none site-container relative z-10 flex h-full flex-col justify-center py-6 sm:py-8">
    <div class="md:max-w-[62%] lg:max-w-[58%]">
      <p
        data-hero-reveal=""
        class="inline-flex items-center gap-2 text-sm font-medium text-slate-300"
      >
        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-[#f43f5e]/20 text-[#f43f5e]" aria-hidden="true">
          <svg class="h-2.5 w-2.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 6.5L5 9l4.5-5.5"></path>
          </svg>
        </span>
        {hero.eyebrow}
      </p>

      <h1
        data-hero-reveal=""
        class="mt-4 text-[1.85rem] font-bold leading-[1.25] tracking-tight text-white sm:mt-5 sm:text-5xl sm:leading-[1.18] md:text-6xl md:tracking-[-0.02em] lg:text-[4rem]"
      >
        <span class="block">{hero.titleLine1}</span>
        <span class="mt-1 block">{hero.titleLine2}</span>
      </h1>

      <p
        data-hero-reveal=""
        class="mt-4 max-w-[20rem] text-sm font-medium leading-relaxed text-slate-300 sm:mt-5 sm:max-w-[42ch] sm:text-base md:max-w-[48ch] md:text-lg"
      >
        <span class="block">{hero.subtitleLine1}</span>
        <span class="block">{hero.subtitleLine2}</span>
      </p>

      <div data-hero-reveal="" class="pointer-events-auto mt-6 flex flex-wrap items-center gap-3 sm:mt-8">
        <a
          href={siteConfig.kakaoChatUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-100 sm:py-3"
        >
          {hero.ctaText}
        </a>
        <a
          href={hero.ctaSecondaryHref}
          class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/5 px-6 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:border-white/55 hover:bg-white/10 sm:py-3"
        >
          {hero.ctaSecondaryText}
        </a>
      </div>
    </div>
  </div>
</section>
