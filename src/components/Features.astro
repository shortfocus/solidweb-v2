---
import { siteConfig } from "@/config/site.config";

const features = siteConfig.ourStrength.items;
---

<section id="features" class="border-t border-slate-800 bg-slate-950">
  <div class="site-container py-20">
    <h2 class="text-center text-3xl font-bold text-slate-100">
      왜 솔리드웹인가요?
    </h2>

    <p class="mt-4 text-center text-slate-400">
      {siteConfig.ourStrength.subtitle}
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6 transition hover:border-[#f43f5e]/50">
            <h3 class="text-lg font-semibold text-slate-100">
              {feature.title}
            </h3>
            <p class="mt-2 text-sm text-slate-400">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
