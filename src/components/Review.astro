---
import { siteConfig } from "@/config/site.config";

const section = siteConfig.review;
/** 마키용으로 길이·수 제한 — 전체 복제×3열은 렌더·페인트 과부하 */
const items = section.items.slice(0, 8).map((r) => ({
  ...r,
  quote: r.quote.length > 140 ? `${r.quote.slice(0, 140)}…` : r.quote,
}));

function rotate<T>(arr: T[], by: number): T[] {
  const n = ((by % arr.length) + arr.length) % arr.length;
  return [...arr.slice(n), ...arr.slice(0, n)];
}

const columns = [
  {
    reverse: false,
    duration: "38s",
    items: rotate(items, 0),
    wrapClass: "relative h-full min-w-0 flex-1 overflow-hidden",
  },
  {
    reverse: true,
    duration: "42s",
    items: rotate(items, 2),
    wrapClass: "relative hidden h-full min-w-0 flex-1 overflow-hidden sm:block",
  },
  {
    reverse: false,
    duration: "40s",
    items: rotate(items, 4),
    wrapClass: "relative hidden h-full min-w-0 flex-1 overflow-hidden lg:block",
  },
];
---

<section id="review" class="overflow-hidden border-t border-white/10 bg-[#0d0d0d] py-20 md:py-28">
  <div class="site-container min-w-0">
    <div data-reveal="" class="max-w-3xl">
      <p class="text-sm font-medium tracking-[0.2em] text-[#f43f5e]">
        {section.sectionLabel}
      </p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        {section.title}
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
        {section.subtitle}
      </p>
    </div>

    <div class="mt-14 border-t border-white/15 pt-10">
      <div
        class="relative flex h-[520px] w-full items-stretch overflow-hidden md:h-[560px]"
        style="perspective: 900px;"
      >
        <div
          class="flex h-full w-full items-stretch gap-3 md:gap-4"
          style="transform: translateZ(-40px) rotateX(12deg) rotateY(-6deg) rotateZ(10deg);"
        >
          {
            columns.map((col) => {
              const loop = [...col.items, ...col.items];
              const marqueeClass = col.reverse
                ? "review-marquee review-marquee--reverse flex w-full flex-col gap-3 will-change-transform"
                : "review-marquee flex w-full flex-col gap-3 will-change-transform";
              return (
                <div class={col.wrapClass}>
                  <div class={marqueeClass} style={`--duration: ${col.duration};`}>
                    {loop.map((r, i) => (
                      <figure
                        class="w-full shrink-0 border border-white/15 bg-[#111] py-5"
                        aria-hidden={i >= col.items.length ? "true" : undefined}
                      >
                        <div class="px-5">
                          <figcaption class="text-sm font-semibold text-white">{r.author}</figcaption>
                          {r.subtitle && (
                            <p class="mt-1 text-xs font-medium tracking-wide text-[#f43f5e]">{r.subtitle}</p>
                          )}
                          <blockquote class="mt-3 text-sm leading-relaxed text-slate-400">
                            {r.quote}
                          </blockquote>
                        </div>
                      </figure>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>

        <div class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-[#0d0d0d] to-transparent sm:w-12" aria-hidden="true" />
        <div class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-[#0d0d0d] to-transparent sm:w-12" aria-hidden="true" />
        <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-[#0d0d0d] to-transparent" aria-hidden="true" />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#0d0d0d] to-transparent" aria-hidden="true" />
      </div>
    </div>
  </div>
</section>
