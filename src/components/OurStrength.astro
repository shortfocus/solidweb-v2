---
import { siteConfig } from "@/config/site.config";

const section = siteConfig.ourStrength;
---

<section id="our-strength" class="border-t border-white/10 bg-[#0d0d0d] py-20 md:py-28">
  <div class="site-container">
    <div data-reveal="" class="max-w-3xl">
      <p class="text-sm font-medium tracking-[0.2em] text-[#f43f5e]">
        {section.sectionLabel}
      </p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        {section.title}
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
        {section.subtitle}
      </p>
    </div>

    <div data-reveal-stagger="" class="mt-14 border-t border-white/15">
      {
        section.items.map((item) => (
          <article class="grid gap-4 border-b border-white/15 py-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)_minmax(0,1.6fr)] md:items-baseline md:gap-8 md:py-12 lg:gap-12">
            <h3 class="text-5xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl">
              {item.acronym}
            </h3>
            <p class="text-sm font-semibold tracking-wide text-[#f43f5e] md:pt-3">
              {item.label}
            </p>
            <div class="md:pt-2">
              <p class="text-base font-semibold text-white md:text-lg">{item.title}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-400 md:text-[0.95rem]">
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
