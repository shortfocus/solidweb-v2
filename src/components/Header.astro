---
import { siteConfig } from "@/config/site.config";

const pathname = Astro.url.pathname;
const navItems = siteConfig.nav.items ?? [
  { label: "홈", href: "/" },
  { label: "포트폴리오", href: "/portfolio" },
];
const consultLabel = siteConfig.nav.consult;
const consultHref = "/contact";

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/" || pathname === "";
  if (href.startsWith("#")) return false;
  return pathname === href || pathname === href + "/";
}
---

<header class="theme-header sticky top-0 z-50 border-b border-white/10 bg-[#0D0D0D]/80 backdrop-blur-md">
  <div class="site-container flex h-16 items-center justify-between">
    <a href="/" class="font-logo text-xl font-bold tracking-tight text-white sm:text-2xl theme-logo">
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
      <nav class="nav-underline hidden md:flex md:items-center md:gap-7" aria-label="메인 메뉴">
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  "nav-link text-sm font-medium transition-colors",
                  active ? "text-white" : "text-slate-400 hover:text-white",
                ]}
                data-href={item.href}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <a
        href={consultHref}
        class="nav-cta hidden rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-slate-100 md:inline-flex"
      >
        {consultLabel}
      </a>

      <div class="flex items-center md:hidden">
        <button
          type="button"
          class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-white/20 bg-transparent text-slate-300 transition hover:border-white/40 hover:text-white"
          aria-label="메뉴 열기"
          id="menu-toggle"
        >
          <span class="h-0.5 w-5 bg-current"></span>
          <span class="h-0.5 w-5 bg-current"></span>
          <span class="h-0.5 w-5 bg-current"></span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="site-container hidden border-t border-white/10 bg-[#0D0D0D]/95 py-4 backdrop-blur-md md:hidden"
  >
    <nav class="flex flex-col gap-1 text-sm" aria-label="모바일 메뉴">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "nav-link rounded-lg py-2.5 pl-3 font-medium transition-colors",
                active ? "bg-white/10 text-white" : "text-slate-400 hover:bg-white/5 hover:text-white",
              ]}
              data-href={item.href}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={consultHref}
        class="mt-2 inline-flex items-center justify-center rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-slate-900"
      >
        {consultLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => menu.classList.toggle("hidden"));
  }

  function setActiveNav() {
    const pathname = window.location.pathname || "/";
    document.querySelectorAll(".nav-link").forEach((el) => {
      const link = el as HTMLAnchorElement;
      const href = link.getAttribute("data-href") || "";
      const isPath = href.startsWith("/") && !href.startsWith("//");
      const active = isPath
        ? pathname === href || pathname === href + "/"
        : false;
      link.classList.toggle("text-white", active);
      link.classList.toggle("text-slate-400", !active);
      if (link.classList.contains("rounded-lg")) {
        link.classList.toggle("bg-white/10", active);
      }
      link.setAttribute("aria-current", active ? "page" : "false");
    });
  }
  setActiveNav();
  window.addEventListener("hashchange", setActiveNav);
  window.addEventListener("popstate", setActiveNav);
</script>
