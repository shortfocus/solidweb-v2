---
import { siteConfig } from "@/config/site.config";

const pathname = Astro.url.pathname;
const navItems = siteConfig.nav.items ?? [
  { label: "홈", href: "/" },
  { label: "포트폴리오", href: "/portfolio" },
];
const consultLabel = siteConfig.nav.consult;
const consultHref = "/contact";

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/" || pathname === "";
  if (href.startsWith("#")) return false;
  return pathname === href || pathname === href + "/";
}
---

<header id="site-header" class="site-header theme-header" data-site-header>
  <div class="nav-shell grid grid-cols-[1fr_auto] items-center gap-4 md:grid-cols-[1fr_auto_1fr]">
    <a
      href="/"
      class="font-logo theme-logo col-start-1 justify-self-start self-stretch text-[1.35rem] font-normal tracking-tight text-white sm:text-[1.6rem]"
    >
      {siteConfig.name}
    </a>

    <nav class="nav-underline col-start-2 hidden items-center justify-center gap-8 md:flex" aria-label="메인 메뉴">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "nav-link relative inline-flex h-8 items-center text-sm font-medium leading-none transition-colors",
                active ? "is-active text-white" : "text-slate-400 hover:text-white",
              ]}
              data-href={item.href}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="col-start-2 flex items-center justify-self-end gap-3 md:col-start-3">
      <a
        href={consultHref}
        class="nav-cta hidden h-9 items-center rounded-full bg-white px-4 text-sm font-semibold leading-none text-slate-900 transition hover:bg-slate-100 md:inline-flex"
      >
        {consultLabel}
      </a>

      <button
        type="button"
        class="menu-toggle flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-white/20 bg-transparent text-slate-300 transition hover:border-white/40 hover:text-white md:hidden"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-toggle"
      >
        <span class="h-0.5 w-5 bg-current"></span>
        <span class="h-0.5 w-5 bg-current"></span>
        <span class="h-0.5 w-5 bg-current"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu absolute inset-x-0 top-[calc(100%+0.5rem)] z-50 hidden overflow-hidden rounded-2xl border border-white/10 bg-[#0D0D0D]/95 py-4 shadow-lg backdrop-blur-md md:hidden"
  >
    <div class="px-5">
      <nav class="flex flex-col gap-1 text-sm" aria-label="모바일 메뉴">
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  "nav-link rounded-lg py-2.5 pl-3 font-medium transition-colors",
                  active ? "bg-white/10 text-white" : "text-slate-400 hover:bg-white/5 hover:text-white",
                ]}
                data-href={item.href}
              >
                {item.label}
              </a>
            );
          })
        }
        <a
          href={consultHref}
          class="mt-2 inline-flex items-center justify-center rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-slate-900"
        >
          {consultLabel}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  }

  function setActiveNav() {
    const pathname = window.location.pathname || "/";
    document.querySelectorAll(".nav-link").forEach((el) => {
      const link = el as HTMLAnchorElement;
      const href = link.getAttribute("data-href") || "";
      const isPath = href.startsWith("/") && !href.startsWith("//");
      const active = isPath
        ? pathname === href || pathname === href + "/"
        : false;
      link.classList.toggle("text-white", active);
      link.classList.toggle("text-slate-400", !active);
      link.classList.toggle("is-active", active);
      if (link.classList.contains("rounded-lg")) {
        link.classList.toggle("bg-white/10", active);
      }
      link.setAttribute("aria-current", active ? "page" : "false");
    });
  }
  setActiveNav();
  window.addEventListener("hashchange", setActiveNav);
  window.addEventListener("popstate", setActiveNav);
</script>
