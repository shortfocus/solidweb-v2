---
import { siteConfig } from "@/config/site.config";

const title = siteConfig.contact.ctaTitle;
const buttonText = siteConfig.contact.ctaButton;
const email = siteConfig.contact.email;
---

<section
  id="contact-cta"
  class="border-t border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950"
>
  <div class="mx-auto w-full max-w-4xl px-5 py-20 text-center sm:px-8 md:px-10 lg:px-12">
    <h2 class="text-3xl font-bold text-slate-100">
      {title}
    </h2>

    <p class="mt-4 text-slate-400">
      지금 문의하면 빠르게 제작 방향을 잡아드립니다
    </p>

    <a
      href={`mailto:${email}`}
      class="mt-8 inline-flex rounded-xl bg-[#f43f5e] px-8 py-4 text-base font-semibold text-white transition hover:bg-[#e11d48]"
    >
      {buttonText}
    </a>
  </div>
</section>
